        {
          "name": "Run All (Sync)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json && json.pipeline && json.pipeline.pipelineId) {",
                  "  pm.collectionVariables.set('pipelineId', json.pipeline.pipelineId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"runMode\": \"sync\",\n  \"title\": \"TM20 RunAll Sync\",\n  \"requirement\": {\n    \"userStory\": \"As a support agent, I want to classify incident priority so that we can meet SLA targets.\",\n    \"requirementId\": \"REQ-2001\",\n    \"userStoryId\": \"US-2001\"\n  },\n  \"llm\": {\n    \"provider\": \"local\",\n    \"endpoint\": \"http://localhost:11434\"\n  },\n  \"options\": {\n    \"numTestCases\": 4,\n    \"categories\": [\"positive\", \"negative\", \"edge\", \"e2e\"]\n  },\n  \"review\": {\n    \"enabled\": false\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v2/pipelines/run-all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v2",
                "pipelines",
                "run-all"
              ]
            }
          }
        },
        {
          "name": "Run All (Async)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 202', function () {",
                  "  pm.response.to.have.status(202);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json && json.pipeline && json.pipeline.pipelineId) {",
                  "  pm.collectionVariables.set('pipelineId', json.pipeline.pipelineId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
