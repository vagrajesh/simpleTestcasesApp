    {
      "name": "Pipeline",
      "item": [
        {
          "name": "Create Pipeline",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json && json.pipeline && json.pipeline.pipelineId) {",
                  "  pm.collectionVariables.set('pipelineId', json.pipeline.pipelineId);",
                  "}",
                  "",
                  "pm.test('pipelineId is captured', function () {",
                  "  pm.expect(pm.collectionVariables.get('pipelineId')).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"TM20 Pipeline Test\",\n  \"requirement\": {\n    \"userStory\": \"As a customer, I want to reset my password so that I can regain account access.\",\n    \"requirementId\": \"REQ-1001\",\n    \"userStoryId\": \"US-1001\",\n    \"feature\": \"Account Access\"\n  },\n  \"llm\": {\n    \"provider\": \"local\",\n    \"endpoint\": \"http://localhost:11434\"\n  },\n  \"options\": {\n    \"numTestCases\": 4,\n    \"categories\": [\"positive\", \"negative\", \"edge\", \"e2e\"]\n  },\n  \"review\": {\n    \"enabled\": true\n  },\n  \"execution\": {\n    \"autoStart\": false\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v2/pipelines",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v2",
                "pipelines"
              ]
            }
          }
        },
