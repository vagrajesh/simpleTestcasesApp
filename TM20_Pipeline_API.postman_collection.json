            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"runMode\": \"async\",\n  \"title\": \"TM20 RunAll Async\",\n  \"requirement\": {\n    \"userStory\": \"As a manager, I want approval workflows so that high-risk changes are reviewed before release.\",\n    \"requirementId\": \"REQ-3001\",\n    \"userStoryId\": \"US-3001\"\n  },\n  \"llm\": {\n    \"provider\": \"local\",\n    \"endpoint\": \"http://localhost:11434\"\n  },\n  \"options\": {\n    \"numTestCases\": 4,\n    \"categories\": [\"positive\", \"negative\", \"edge\", \"e2e\"]\n  },\n  \"review\": {\n    \"enabled\": true\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v2/pipelines/run-all",
              "host": [
                "{{baseUrl}}"
              ],
