# ==========================
# Server Environment Variables
# ==========================

# Port to run the server on (default: 3001)
PORT=3001

# Origin of your React dev server (Vite default: 5173)
CLIENT_ORIGIN=http://localhost:5173

# ── Groq Provider ──────────────────────────────────────
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── OpenAI Provider ────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── Local LLM / Dev Safety ─────────────────────────────
# Set to "true" to allow the local provider to call private/loopback addresses.
# Required when running Ollama (localhost:11434) or LM Studio (localhost:1234) locally.
# NEVER set this to true in production.
ALLOW_LOCAL_ENDPOINTS=false

# Node environment
NODE_ENV=development

# ── ServiceNow Integration ─────────────────────────────
# Shared service-account credentials (OAuth2 client_credentials grant).
# All three must be set for the ServiceNow integration to be considered configured.
# Create an OAuth application registry in ServiceNow to get a client id/secret:
# https://your-instance.service-now.com -> System OAuth -> Application Registry
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_CLIENT_ID=your_servicenow_client_id
SERVICENOW_CLIENT_SECRET=your_servicenow_client_secret
