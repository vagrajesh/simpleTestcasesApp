# Copy this file to server/.env and fill in your values

PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Groq cloud provider — get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenAI cloud provider — get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Set to true ONLY in local development to allow calling Ollama / LM Studio on localhost
ALLOW_LOCAL_ENDPOINTS=false

NODE_ENV=development
